{
  "manifest_version": 3,
  "name": "Aplico — Quick Resume Attacher",
  "version": "1.0.0",
  "description": "Select and attach your saved Aplico resumes to job applications on supported portals with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aplico Resume Attacher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  }
}
